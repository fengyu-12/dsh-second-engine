# 第二引擎桥 · 环境变量一览（都是可选的，括号内是默认值）

# 工作目录：新会话落在这里 / 所有者进程的 cwd（$HOME/proj）
BRIDGE_WORKDIR=$HOME/proj

# 网页监听端口（3095）
BRIDGE_PORT=3095
# 网页绑定地址，默认只绑本机（127.0.0.1）
BRIDGE_HOST=127.0.0.1

# 会话所有者监听端口，ws:// 形式（3096）
BRIDGE_AS_PORT=3096
# 或者直接给完整地址，优先级更高（ws://127.0.0.1:3096）
#BRIDGE_AS_URL=ws://127.0.0.1:3096

# 一轮最多跑多久，超时自动中断（1800000 = 30 分钟）
BRIDGE_TURN_TIMEOUT_MS=1800000

# 从哪个文件读提供方 key（~/.codex/keyring.json，DSH 托管）
BRIDGE_KEYRING=$HOME/.codex/keyring.json

# codex 可执行文件（PATH 里的 codex）
CODEX_BIN=codex

# 启动器/安装器用的目录
#BRIDGE_DIR=$HOME/.local/share/second-engine-bridge
#CODEX_KEYRING=$HOME/.codex/keyring.json
#SECOND_ENGINE_WORKDIR=$HOME/proj
#BIN_DIR=$HOME/.local/bin
