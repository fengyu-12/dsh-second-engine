{
  "name": "dsh-second-engine",
  "version": "1.2.1",
  "description": "Second engine plugin for DeepSeek Harness: plug OpenAI Codex CLI in as a second agent — async work orders, adversarial review, a shared terminal/web session bridge, and a file-based task board.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "bridge",
    "tools",
    "src",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengyu-12/dsh-second-engine.git"
  },
  "homepage": "https://github.com/fengyu-12/dsh-second-engine#readme",
  "bugs": {
    "url": "https://github.com/fengyu-12/dsh-second-engine/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "codex",
    "codex-cli",
    "terminal-agent",
    "second-engine"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}